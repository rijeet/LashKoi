{
  "name": "@lashkoi/api",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "cross-env NODE_OPTIONS=\"--require ./load-env.js\" nest start --watch",
    "start:prod": "node dist/main.js",
    "typeorm:run": "cross-env NODE_OPTIONS=\"--require ./load-env.js --require tsconfig-paths/register\" typeorm-ts-node-commonjs migration:run -d ./src/APP.Infrastructure/db/typeorm/AppDataSource.datasource.ts",
    "typeorm:revert": "cross-env NODE_OPTIONS=\"--require ./load-env.js --require tsconfig-paths/register\" typeorm-ts-node-commonjs migration:revert -d ./src/APP.Infrastructure/db/typeorm/AppDataSource.datasource.ts",
    "seed": "cross-env NODE_OPTIONS=\"--require ./load-env.js\" ts-node -r tsconfig-paths/register --transpile-only src/seeds/run-seed.ts",
    "seed:areas": "cross-env NODE_OPTIONS=\"--require ./load-env.js\" ts-node -r tsconfig-paths/register --transpile-only src/seeds/seed-admin-areas.ts",
    "seed:demo": "cross-env NODE_OPTIONS=\"--require ./load-env.js\" ts-node -r tsconfig-paths/register --transpile-only src/seeds/seed-demo-incidents.ts",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.2.1",
    "@nestjs/typeorm": "^11.0.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.4.5",
    "helmet": "^8.0.0",
    "isomorphic-dompurify": "^2.21.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "nestjs-pino": "^4.4.1",
    "pg": "^8.16.3",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.8",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "@vercel/node": "^5.10.2",
    "cross-env": "^10.1.0",
    "jest": "^30.2.0",
    "pino-pretty": "^13.1.2",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
