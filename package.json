{
  "name": "lashkoi",
  "private": true,
  "description": "Bangladesh incident map — monorepo (apps/api, apps/web)",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "phase0:check": "node scripts/phase0-check-env.mjs",
    "api:dev": "npm run start:dev --workspace=@lashkoi/api",
    "api:build": "npm run build --workspace=@lashkoi/api",
    "api:migrate": "npm run typeorm:run --workspace=@lashkoi/api",
    "api:seed": "npm run seed --workspace=@lashkoi/api",
    "api:seed:areas": "npm run seed:areas --workspace=@lashkoi/api",
    "web:dev": "npm run dev --workspace=@lashkoi/web",
    "web:build": "npm run build --workspace=@lashkoi/web",
    "web:geo": "node scripts/simplify-geo.mjs",
    "web:geo:bn": "node scripts/import-wikipedia-bn.mjs",
    "web:geo:dhaka-unions": "node scripts/extract-dhaka-union-polygons.mjs",
    "api:seed:demo": "npm run seed:demo --workspace=@lashkoi/api",
    "phase2:smoke": "node scripts/phase2-smoke.mjs",
    "phase2:setup": "npm run api:migrate && npm run api:seed && npm run api:seed:demo"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@indic-transliteration/sanscript": "^1.3.3"
  }
}
